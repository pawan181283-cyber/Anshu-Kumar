# ─────────────────────────────────────────────────────────────
# Aladdin's Lamp — NSE Announcements Bot  (.env.example)
# Copy this file to `.env` and fill in your real values.
# ─────────────────────────────────────────────────────────────

# Gemini API key (get one free at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Telegram chat ID where alerts should be sent (use @userinfobot to find yours)
TELEGRAM_CHAT_ID=123456789

# Render public URL (used for the keep-alive self-ping).
# On Render this is auto-injected as RENDER_EXTERNAL_URL; you can leave this blank.
RENDER_APP_URL=https://your-app-name.onrender.com

# ── Optional tuning ──────────────────────────────────────────
# Port Render binds to (Render injects this automatically)
# PORT=10000

# Seconds between announcement scans (default 300 = 5 min)
# CHECK_INTERVAL_SECONDS=300

# Max Gemini classifications per scan cycle (default 15)
# MAX_EVALUATIONS_PER_CYCLE=15

# Daily Gemini call budget (default 300)
# GEMINI_DAILY_CALL_BUDGET=300

# Days to keep dedup history (default 30)
# SEEN_PRUNE_AFTER_DAYS=30
